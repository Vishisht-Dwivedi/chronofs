{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-all",
            "type": "shell",
            "command": "mkdir -p build && gcc -Wall -Wextra -pthread -g ${workspaceFolder}/src/chronofs_daemon.c ${workspaceFolder}/src/common/utilities.c ${workspaceFolder}/src/fs/events.c ${workspaceFolder}/src/fs/socket_events.c ${workspaceFolder}/src/fs/watcher.c -o ${workspaceFolder}/build/chronofs_daemon && gcc -Wall -Wextra -pthread -g ${workspaceFolder}/src/chronofs_listener.c -o ${workspaceFolder}/build/chronofs_listener",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-13 build active file",
            "command": "/usr/bin/gcc-13",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/build/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build currently active file"
        }
    ]
}